{
  "functions": [
    {
      "source": ".",
      "codebase": "beacon-relay",
      "runtime": "nodejs22",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": ["node_modules", "src", "test", "tsconfig.json", "*.local"]
    }
  ],
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "storage": { "port": 9199, "host": "127.0.0.1" },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
